<Window x:Class="Pdf2Hwp.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDF2HWP" Width="1040" Height="720" MinWidth="820" MinHeight="560" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="Undo" IsEnabled="{Binding CanUndo}" ToolTip="실행 취소 (Ctrl+Z)">실행 취소</Button><Button Margin="6,0,0,0" Click="Redo" IsEnabled="{Binding CanRedo}" ToolTip="다시 실행 (Ctrl+Y)">다시 실행</Button><Button Margin="12,0,0,0" Click="OpenSettings" ToolTip="설정 열기">설정</Button><Button Margin="6,0,0,0" Click="OpenDiagnostics" ToolTip="진단 JSON 내보내기">진단</Button></StackPanel><StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="PDF2HWP"/><TextBlock Foreground="Gray" Text="PDF → HWPX/HWP 고정밀 변환"/></StackPanel></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,16,0,10"><Button Width="110" Click="SelectFiles" ToolTip="PDF 파일을 추가합니다 (Ctrl+O)">PDF 추가</Button><Button Width="110" Margin="6,0" Click="SelectOutput">출력 폴더</Button><TextBlock VerticalAlignment="Center" Text="출력: "/><TextBox Width="230" Margin="4,0,12,0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/><TextBlock VerticalAlignment="Center" Text="이름: "/><TextBox Width="120" Margin="4,0,12,0" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" ToolTip="파일명 stem (자동 이름 정책 적용)"/><TextBlock VerticalAlignment="Center" Text="형식: HWPX"/><TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="모드: "/><ComboBox Width="140" SelectedValue="{Binding Mode}" SelectedValuePath="Tag"><ComboBoxItem Tag="SafeHybrid">Safe Hybrid</ComboBoxItem><ComboBoxItem Tag="VisualFidelity">Visual Fidelity</ComboBoxItem><ComboBoxItem Tag="Editable">Editable</ComboBoxItem></ComboBox><TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="렌더: "/><ComboBox Width="90" SelectedValue="{Binding RenderQuality}" SelectedValuePath="Tag"><ComboBoxItem Tag="Standard">200 DPI</ComboBoxItem><ComboBoxItem Tag="High">300 DPI</ComboBoxItem></ComboBox><CheckBox Margin="14,0,0,0" IsChecked="{Binding OcrAuto}" Content="OCR Auto" ToolTip="텍스트가 없는 페이지에만 OCR을 적용합니다"/><CheckBox Margin="10,0,0,0" IsChecked="{Binding Verify}" Content="원본 비교 검증"/></WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border BorderBrush="#C9CDD2" BorderThickness="1" CornerRadius="4" Padding="8"><ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Extended" AllowDrop="True" Loaded="OnPageListLoaded" ScrollViewer.ScrollChanged="OnPageScrollChanged" SelectionChanged="OnPageSelectionChanged" PreviewMouseDown="OnPageMouseDown" PreviewMouseMove="OnPageMouseMove" Drop="OnPageDrop" DragOver="OnPageDragOver" AutomationProperties.Name="PDF 페이지 목록"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ContextMenu><ContextMenu><MenuItem Header="페이지 제거" Click="RemovePages"/><MenuItem Header="페이지 복제" Click="DuplicatePage"/><MenuItem Header="포함/제외 전환" Click="ToggleIncluded"/><MenuItem Header="이 PDF의 모든 페이지 선택" Click="SelectSourcePages"/><MenuItem Header="미리보기 다시 생성" Click="RetryPreview"/></ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate><Border Padding="8" Margin="2" BorderBrush="#E2E5E8" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Border Width="64" Height="64" Background="#F1F3F5"><Grid><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/><TextBlock Text="{Binding PreviewState}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B7280"/></Grid></Border><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding SourcePath}" Foreground="Gray" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding IncludeLabel}" Foreground="#2563EB"/><TextBlock Text="{Binding OrientationLabel}" Foreground="Gray"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LogicalLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="Gray"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock FontWeight="SemiBold" Text="페이지 편집" Margin="0,0,0,8"/><Button Click="RemovePages" Margin="0,2" ToolTip="선택 페이지 제거 (Delete)">선택 페이지 제거</Button><Button Click="DuplicatePage" Margin="0,2" ToolTip="선택 페이지 복제 (Ctrl+D)">선택 페이지 복제</Button><Button Click="ToggleIncluded" Margin="0,2">포함/제외 전환</Button><Button Click="ClearPages" Margin="0,2">전체 비우기</Button><Separator Margin="0,12"/><TextBlock Text="최근 파일" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding RecentFiles}" DisplayMemberPath="Path" Height="72" Margin="0,4"/><TextBlock Text="최근 변환" FontWeight="SemiBold"/><ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Height="125" Margin="0,4"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding OutputFileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="Gray"/><TextBlock Text="{Binding StatusLabel}"/></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="출력 폴더 열기" Click="HistoryOpenFolder"/><MenuItem Header="출력 파일 열기" Click="HistoryOpenOutput"/><MenuItem Header="보고서 열기" Click="HistoryOpenReport"/><MenuItem Header="다시 시도" Click="HistoryRetry"/><MenuItem Header="기록 삭제" Click="HistoryRemove"/></ContextMenu></ListBox.ContextMenu></ListBox><Button Click="HistoryClear" Margin="0,2">변환 기록 모두 지우기</Button><Button Click="ClearPreviewCache" Margin="0,2">미리보기 캐시 지우기</Button><TextBlock Text="{Binding PreviewCacheSummary}" Foreground="Gray" Margin="0,6"/><TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,4,0,0"/></StackPanel></Grid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding Progress}"/><DockPanel Margin="0,7,0,0"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="{Binding PageSummary}" Foreground="Gray"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Width="120" Click="Convert" ToolTip="변환 시작 (Ctrl+Enter)">변환 시작</Button><Button Width="90" Margin="6,0" Click="Cancel">취소 (Esc)</Button><Button Width="120" Margin="6,0" Click="OpenResults">결과 폴더 열기</Button><Button Width="120" Margin="6,0" Click="ExportReport">검증 리포트</Button></StackPanel></StackPanel>
 </Grid>
</Window>
